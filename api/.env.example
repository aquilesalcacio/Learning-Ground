# Copy to api/.env and fill in. Never commit api/.env.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
# Optional. Comma-separated models to try in order.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# Auth0 (login). The API checks the web's access tokens against this tenant and API identifier.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.learning-grounds.dev
# Local only: 1 skips the token check. Never on a deployed server.
# AUTH_DISABLED=1

# Canvas LMS OAuth2 (Admin > Developer Keys > API Key on our Canvas LMS instance).
CANVAS_LMS_BASE_URL=
CANVAS_LMS_CLIENT_ID=
CANVAS_LMS_CLIENT_SECRET=
CANVAS_LMS_REDIRECT_URI=http://localhost:8000/canvas-lms/callback
# Any long random string: openssl rand -hex 32
CANVAS_LMS_STATE_SECRET=
# Optional. Space-separated; must match the Developer Key's scopes. Empty if the key doesn't enforce scopes.
# CANVAS_LMS_SCOPES=url:GET|/api/v1/users/:id url:GET|/api/v1/courses url:GET|/api/v1/courses/:course_id/assignments
# CANVAS_LMS_TIMEZONE=America/New_York
# Where the API sends the browser back after Canvas LMS.
WEB_BASE_URL=http://localhost:3000
# Dev only, for scripts/canvas_lms_seed.py: the Canvas LMS admin's own token. The app never reads it.
# CANVAS_LMS_ADMIN_TOKEN=

# Canvas LMS LTI 1.1 app, for Canvas Lite and any course where the teacher adds external apps.
LTI_CONSUMER_KEY=learning-grounds
# Any long random string: openssl rand -hex 24. The teacher pastes it into Canvas LMS.
LTI_SHARED_SECRET=
LTI_LAUNCH_URL=http://localhost:8000/lti/launch
# Optional: extra hosts whose calendar feeds may be imported (*.instructure.com is always allowed).
# CANVAS_LMS_FEED_HOSTS=canvas.myschool.edu
