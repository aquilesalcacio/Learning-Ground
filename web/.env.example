# Copy to web/.env.local and fill in. Never commit .env.local.
# Auth0 Regular Web Application (Applications > your app > Settings).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Any long random string: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# The Auth0 API identifier. Must match AUTH0_AUDIENCE in api/.env.
AUTH0_AUDIENCE=https://api.learning-grounds.dev

NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional locally: tldraw only needs a license key on a live HTTPS domain.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
